# Copy this file to .env and edit the values for your Home Assistant setup.

# Your Home Assistant base URL. Use a LAN address that the Docker host can reach.
# Examples:
# HOME_ASSISTANT_URL=http://homeassistant.local:8123
# HOME_ASSISTANT_URL=http://192.168.1.20:8123
HOME_ASSISTANT_URL=http://homeassistant.local:8123

# Create a Long-Lived Access Token in Home Assistant:
# Profile -> Security -> Long-Lived Access Tokens
HOME_ASSISTANT_TOKEN=replace_me_with_a_long_lived_access_token

# Port exposed on the Docker host.
PANEL_PORT=8080

# Optional. Leave as-is unless you rename or move the config file.
PANEL_CONFIG_PATH=/app/config/panel-config.json
